[Unit]
Description=Qoder to OpenAI-compatible API gateway (coding2api)
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=%i
WorkingDirectory=/opt/qoder2api
ExecStart=/root/.local/bin/uv run python -m uvicorn src.main:build_app --factory --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5
# Environment lives in /opt/qoder2api/.env (APP_SECRET, QODER_* endpoints)

[Install]
WantedBy=multi-user.target
